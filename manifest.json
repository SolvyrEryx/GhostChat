{
  "manifest_version": 3,
  "name": "GhostChat",
  "version": "1.0.0",
  "description": "Reclaim your privacy. End-to-end AES-GCM encryption for Discord Web.",
  "author": "Rahul J",

  "permissions": ["storage"],
  "host_permissions": ["*://*.discord.com/*"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostChat — Reclaim Your Privacy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.discord.com/*"],
      "js": ["crypto.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}